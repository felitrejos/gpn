# gpn profile
#
# Copy to ~/.config/gpn/default.conf and edit.
# Extra profiles are just extra files: ~/.config/gpn/work.conf, used as
#   gpn -p work connect
#
# This file is sourced by bash, so it is shell syntax, and any value may be a
# command substitution.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# The GlobalProtect portal hostname, without https://
PORTAL="vpn.example.edu"

# ---------------------------------------------------------------------------
# Sign-in
# ---------------------------------------------------------------------------

# Seconds to wait for the sign-in before giving up. Generous by default: it
# covers reading an MFA prompt on your phone.
SAML_TIMEOUT="300"

# The sign-in window, built by install.sh. Only set this if you moved it.
# SAML_APP="$HOME/Applications/GPNSamlLogin.app"

# 1 = authenticate straight to the gateway (/ssl-vpn/)
# 0 = go through the portal first (/global-protect/)
#
# This picks which endpoint starts the sign-in, and so which cookie comes back:
# the gateway returns a prelogin-cookie, the portal a portal-userauthcookie.
# Leave it at 1 unless the gateway refuses the cookie, or your portal fronts
# several gateways and you need it to choose one.
GATEWAY_MODE="1"

# ---------------------------------------------------------------------------
# 1Password (optional)
# ---------------------------------------------------------------------------

# Fill the identity provider's sign-in from a 1Password login item. This is a
# secret *reference* — vault and item, not a password — so it is safe here.
# Needs the 1Password app with "Integrate with 1Password CLI" on, and `op`.
# The window reads username, password and the "one-time password" field, each
# only when the page asks for it; 1Password asks for Touch ID to allow it.
# Unset = no 1Password at all.
# OP_ITEM="op://Private/University SSO"

# 1 = fill each field as it appears and submit it, and answer Entra's
#     "Stay signed in?" with yes so the next connect needs nothing.
# 0 = only when you press Cmd+Shift+L (Edit > Fill from 1Password).
# Either way each field is filled at most once, and the first error the page
# shows hands the window back to you — a wrong password is never retried.
OP_AUTOFILL="1"

# Hosts the fill may happen on, space-separated. Anything else — including a
# redirect to your institution's own login page — gets nothing.
OP_FILL_HOSTS="login.microsoftonline.com"

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Report a specific GlobalProtect client version. Some portals nag or refuse if
# the version looks too old. Copy whatever the real client reports.
GP_VERSION=""

# OS openconnect claims to be: linux, linux-64, win, mac-intel, android, apple-ios
OS_TYPE="mac-intel"

# Extra openconnect flags, word-split. e.g. "--no-dtls --mtu=1400"
OPENCONNECT_EXTRA=""

# Override autodetection if needed.
OPENCONNECT_BIN=""
VPNC_SCRIPT=""
